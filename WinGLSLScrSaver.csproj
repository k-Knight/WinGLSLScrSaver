<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WinGLSLScrSaver</AssemblyName>
    <RootNamespace>WinGLSLScrSaver</RootNamespace>
    <Version>1.3.1</Version>
    <!-- Fallback for the very first restore: $(PkgScintilla_NET) is only
         generated by NuGet during restore, but an empty value makes the
         EmbeddedResource globs below resolve from the drive root and abort
         evaluation before restore ever runs. -->
    <PkgScintilla_NET Condition="'$(PkgScintilla_NET)' == ''">$(NuGetPackageFolders)\scintilla.net</PkgScintilla_NET>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pie" Version="0.10.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.3.4" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.3.4" />
    <PackageReference Include="Scintilla.NET" Version="5.*" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Embed the Scintilla native DLLs from the NuGet cache as resources named
       exactly "Scintilla.dll" / "Lexilla.dll" (the names NativeDeps.cs looks
       up); NativeDeps.Ensure() writes them to x64\ next to the exe at start. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgScintilla_NET)\**\x64\Scintilla.dll" LogicalName="Scintilla.dll" />
    <EmbeddedResource Include="$(PkgScintilla_NET)\**\x64\Lexilla.dll" LogicalName="Lexilla.dll" />
  </ItemGroup>

</Project>
